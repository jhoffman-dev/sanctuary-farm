## How an answer was graded. Latency decides between the three correct outcomes.
## Strings, as in TypeScript, so a session log reads the same in a save file.
class_name Outcome
extends RefCounted

const FLUENT := "FLUENT"
const SLOW := "SLOW"
const LABORED := "LABORED"
const WRONG := "WRONG"
const ALL: Array[String] = [FLUENT, SLOW, LABORED, WRONG]
