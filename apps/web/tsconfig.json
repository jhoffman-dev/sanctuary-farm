{
  "extends": "@sf/config/tsconfig.dom.json",
  "compilerOptions": {
    "types": ["vite/client"],
    // The dev server's save plugin is loaded with the Vite config, whose
    // loader wants real file extensions on relative imports.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
