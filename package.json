{
  "name": "sanctuary-farm",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sf/web dev",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "test": "vitest run && pnpm test:functions",
    "test:coverage": "vitest run --coverage",
    "test:functions": "pnpm --filter @sf/functions test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sanctuary-farm \"vitest run --config firestore/vitest.config.ts\"",
    "emulators": "firebase emulators:start --only hosting,firestore,functions,auth --project demo-sanctuary-farm",
    "deploy:game": "firebase deploy --only hosting:game",
    "deploy:landing": "firebase deploy --only hosting:landing",
    "deploy:functions": "firebase deploy --only functions:sanctuary-farm",
    "deploy:rules": "firebase deploy --only firestore:sanctuary-farm",
    "build": "pnpm -r build",
    "size": "pnpm --filter @sf/web size",
    "lhci": "pnpm --filter @sf/web build && lhci autorun --config=lighthouserc.cjs",
    "e2e": "pnpm e2e:web && pnpm e2e:landing",
    "e2e:web": "pnpm --filter @sf/web e2e",
    "e2e:landing": "playwright test --config apps/landing/playwright.config.ts",
    "godot:import": "\"${GODOT_BIN:-/Applications/Godot.app/Contents/MacOS/Godot}\" --headless --path game --import",
    "godot:layers": "bash game/tools/check_layers.sh",
    "godot:test": "pnpm godot:layers && bash game/tools/run_tests.sh",
    "godot:export:web": "mkdir -p game/build/web && \"${GODOT_BIN:-/Applications/Godot.app/Contents/MacOS/Godot}\" --headless --path game --export-release Web build/web/index.html",
    "godot:e2e:web": "playwright test --config game/tests/web/playwright.config.ts",
    "godot:gate": "pnpm godot:import && pnpm godot:test && pnpm godot:export:web && pnpm godot:e2e:web",
    "gate": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test:coverage && pnpm test:functions && pnpm build && pnpm size"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "firebase": "^12.18.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
